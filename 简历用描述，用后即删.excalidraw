    {
      "id": "mjP3WH9z5tlhDkOv6pNfI",
      "type": "text",
      "x": 1910.3333740234375,
      "y": 524.5,
      "width": 800,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aA",
      "roundness": null,
      "seed": 2122124323,
      "version": 315,
      "versionNonce": 760952234,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1793186909529,
      "created": 1792838666286,
      "link": null,
      "locked": false,
      "text": "因为扩容操作非常耗时，如果能够确定字典的容量且不会频繁变动，在new的时候直接带容\n量声明，可以减少扩容开销",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "因为扩容操作非常耗时，如果能够确定字典的容量且不会频繁变动，在new的时候直接带容量声明，可以减少扩容开销",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "4KREbOUWllmiKJ4oIKPKC",
      "type": "text",
      "x": 795.3333740234375,
      "y": 1055.5000305175781,
      "width": 294.80389404296875,
      "height": 57,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
