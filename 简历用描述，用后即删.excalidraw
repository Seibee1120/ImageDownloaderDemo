      "isDeleted": true,
      "boundElements": [],
      "updated": 1793186909529,
      "created": 1792942894459,
      "link": null,
      "locked": false,
      "text": "使用“链地址法”解决哈希冲突，相同哈希值的数据存在同一个桶里，新增数据时通过头插法\n挂载到链表头部",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "使用“链地址法”解决哈希冲突，相同哈希值的数据存在同一个桶里，新增数据时通过头插法挂载到链表头部",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "l41JlMIYBjOwqJYibVJWw",
      "type": "text",
      "x": 1998.6667285561562,
      "y": 622.833251953125,
      "width": 503.67987060546875,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
